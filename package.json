{
  "name": "excalimacs",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/copy-fonts.mjs",
    "build": "vite build",
    "upgrade:excalidraw": "npm install --save-exact @excalidraw/excalidraw@next && npm run build",
    "test": "emacs -Q --batch -L . -L ../emacs-web-server.github.skeeto -l excalimacs.el -l tests/excalimacs-test.el -f ert-run-tests-batch-and-exit",
    "test:unit": "node --test tests/*.test.js",
    "test:browser": "node scripts/test-browser.mjs",
    "test:pens": "node scripts/test-browser.mjs pens",
    "test:all": "npm test && npm run test:unit && npm run test:browser"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.0-1118751",
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "perfect-freehand": "1.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "vite": "^7.1.0"
  }
}
